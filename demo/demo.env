# Shared by demo/setup.sh, demo/race.sh and demo/reset.sh. Override any of these from the environment.

# Where the humanize clone lives (created by setup.sh).
DEMO_DIR="${DEMO_DIR:-$HOME/code/humanize}"

# Gemini is left out by default: its free API tier allows 20 requests a day, too few for an agent run.
AGENTS="${AGENTS:-claude,codex}"

PROMPT="${PROMPT:-Fix https://github.com/python-humanize/humanize/issues/379: precisedelta() silently drops the sign of negative timedeltas. Keep the sign for every output form (a single unit, several units, and plain numbers of seconds), leave positive output unchanged, and add tests covering negative inputs.}"

# The whole humanize suite through uv, with no project venv or lockfile left in the worktree.
VERIFY="${VERIFY:-uv run --quiet --no-project --with-editable . --with pytest --with freezegun --with pytest-benchmark --with pytest-codspeed pytest -q -p no:cacheprovider --benchmark-disable}"

SUPERSET_BIN="${SUPERSET_BIN:-$(command -v superset || echo "$HOME/.superset/bin/superset")}"
export SUPERSET_BIN
